# Example environment for the release Compose kit's compose.yaml.
# Copy it, set the values, and run the deployment with them in the shell
# environment (or hand them to `container install`). No value here is usable
# as a credential: credentials live in the configuration file and
# the project volume, never in Compose environment, labels or command.

# An existing owner-only directory holding config.toml, both owned by the
# service identity: the host subordinate uid that the image's fixed numeric
# service uid maps to, not the invoking operator.
JAYNSHARE_CONFIG_DIR=/etc/jaynshare/pool-a

# One explicit loopback or private host address and one explicit unique host
# port.
JAYNSHARE_HOST_IP=127.0.0.1
JAYNSHARE_HOST_PORT=17421

# Resource limits: operator-adjustable, never omitted.
JAYNSHARE_CPUS=1.0
JAYNSHARE_MEMORY=512m
JAYNSHARE_PIDS=128
